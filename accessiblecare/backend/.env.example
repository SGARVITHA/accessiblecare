# AccessibleCare Backend Environment Template

# Application Settings
APP_NAME=AccessibleCare API
APP_VERSION=0.1.0
ENVIRONMENT=development
API_HOST=127.0.0.1
API_PORT=8000

# Hospital deployment context (Backend Only)
# UUID of the hospital this AccessibleCare deployment serves.
# Do not expose this as a patient-editable field in the frontend.
ACCESSIBLECARE_HOSPITAL_ID=

# Supabase Configuration (Backend Only)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google / Gemini API (Backend Only)
GOOGLE_API_KEY=
